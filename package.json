{
  "name": "tally",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "contract:lint": "bash scripts/openapi/redocly-run.sh lint contracts/openapi/openapi.yaml",
    "contract:bundle": "bash scripts/openapi/redocly-run.sh bundle contracts/openapi/openapi.yaml --output contracts/openapi/dist/openapi.bundle.yaml",
    "contract:check": "bash scripts/openapi/contract-check.sh",
    "api:generate:ts": "bash scripts/openapi/typescript-generate.sh",
    "build": "pnpm run build:api && pnpm run build:web",
    "build:api": "go build ./cmd/api",
    "build:web": "pnpm -C web run build",
    "test": "pnpm run test:api && pnpm run test:web",
    "test:api": "go test ./...",
    "test:web": "pnpm -C web run test",
    "check": "pnpm run test && pnpm run build",
    "dev-api": "go run ./cmd/api",
    "dev-web": "pnpm -C web run dev"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "1.34.4",
    "typescript": "6.0.2"
  }
}
