{
  "required_modules": [
    "resource_group",
    "log_analytics",
    "container_registry",
    "container_app_environment",
    "api_identity",
    "worker_identity",
    "api",
    "worker",
    "static_web_app",
    "postgresql",
    "key_vault"
  ],
  "required_outputs": [
    "environment_profile",
    "resource_group_id",
    "container_app_environment_id",
    "api_id",
    "static_web_app_id",
    "static_web_app_hostname",
    "api_url",
    "worker_id",
    "postgres_server_id",
    "postgres_server_fqdn",
    "database_id",
    "key_vault_id",
    "key_vault_uri",
    "log_analytics_workspace_id",
    "application_insights_id",
    "api_identity_id",
    "api_identity_principal_id",
    "worker_identity_id",
    "worker_identity_principal_id",
    "container_registry_id",
    "container_registry_login_server",
    "container_registry_name",
    "api_image_repository",
    "api_image_digest",
    "worker_image_repository",
    "worker_image_digest",
    "production_deletion_lock_enabled"
  ],
  "profiles": {
    "dev": {
      "network_mode": "public",
      "postgres_mode": "public",
      "data_classification": "synthetic",
      "requires_expiry": false,
      "requires_lock": false
    },
    "demo": {
      "network_mode": "public",
      "postgres_mode": "public",
      "data_classification": "synthetic",
      "requires_expiry": true,
      "requires_lock": false
    },
    "prod-reference": {
      "network_mode": "private",
      "postgres_mode": "private",
      "data_classification": "confidential",
      "requires_expiry": false,
      "requires_lock": true
    }
  }
}
