# Public browser-only local-development configuration.
# Copy this file to web/.env.local before starting the Vite dev server.
# These values identify the Entra application; never put passwords, client
# secrets, or access tokens in this file.

VITE_APP_ENV=local
VITE_AUTH_MODE=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_API_SCOPE=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
