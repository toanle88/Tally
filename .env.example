# Public, local-development-only configuration.
# Copy this file to .env before validating or starting PostgreSQL.
# Never reuse these values in shared or production environments.

COMPOSE_PROJECT_NAME=tally

TALLY_DB_NAME=tally_local
TALLY_DB_USER=tally_local
TALLY_DB_PASSWORD=tally_local_only_not_a_secret
TALLY_DB_PORT=5432

DATABASE_URL="postgresql://${TALLY_DB_USER}:${TALLY_DB_PASSWORD}@127.0.0.1:${TALLY_DB_PORT}/${TALLY_DB_NAME}?sslmode=disable"

# API authentication boundary. Leave blank until a tenant-scoped OIDC discovery
# endpoint is intentionally configured. Never commit tenant IDs or credentials.
# External ID pattern: https://<tenant-name>.ciamlogin.com/<tenant-id>/v2.0/.well-known/openid-configuration
APP_ENV=local
TALLY_AUTH_MODE=
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_METADATA_URL=
